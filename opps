# 3. Calculator
# Create Calculator class with add(), subtract(),
# multiply(), and divide().
# Take two numbers from the user and perform all operations.

class Calculator:
    def add(self, a, b):
        return a + b

    def subtract(self, a, b):
        return a - b

    def multiply(self, a, b):
        return a * b

    def divide(self, a, b):
        return a / b


print("\n----- 3. Calculator -----")

a = float(input("Enter first number: "))
b = float(input("Enter second number: "))

calc = Calculator()

print("Addition:", calc.add(a, b))
print("Subtraction:", calc.subtract(a, b))
print("Multiplication:", calc.multiply(a, b))

if b != 0:
    print("Division:", calc.divide(a, b))
else:
    print("Division: Cannot divide by zero")


