# 7. Student Grade
# Create a Student class with calculate_grade() that returns:
#
# 90-100  -> A
# 75-89   -> B
# 60-74   -> C
# 40-59   -> D
# Below 40 -> F

class StudentGrade:
    def __init__(self, marks):
        self.marks = marks

    def calculate_grade(self):
        if self.marks >= 90 and self.marks <= 100:
            return "A"
        elif self.marks >= 75 and self.marks < 90:
            return "B"
        elif self.marks >= 60 and self.marks < 75:
            return "C"
        elif self.marks >= 40 and self.marks < 60:
            return "D"
        elif self.marks >= 0 and self.marks < 40:
            return "F"


student = StudentGrade(85)

print("\n----- 7. Student Grade -----")
print("Marks:", student.marks)
print("Grade:", student.calculate_grade())


